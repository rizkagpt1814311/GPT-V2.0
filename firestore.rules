rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function myRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAdmin() {
      return myRole() in ['admin', 'super_admin'];
    }
    function isModOrAdmin() {
      return myRole() in ['moderator', 'admin', 'super_admin'];
    }
    // Fields a normal user is never allowed to change on their own profile.
    function keepsProtectedFieldsUnchanged() {
      let before = resource.data;
      let after  = request.resource.data;
      return after.role == before.role
        && after.accountStatus == before.accountStatus
        && after.uid == before.uid;
    }

    // ---- users/{uid} ----
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isModOrAdmin();
      // Owner can create/update their own doc but cannot touch role/accountStatus.
      allow create: if isOwner(uid) && request.resource.data.role == 'user' && request.resource.data.accountStatus == 'active';
      allow update: if (isOwner(uid) && keepsProtectedFieldsUnchanged()) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();

      // Per-user limits & usage
      match /settings/limits {
        allow read: if isOwner(uid) || isAdmin();
        // Only admins may write limits. (Server-enforced defaults are seeded by
        // the client on profile completion; tighten this further with a Cloud
        // Function if you want even that initial write to be server-only.)
        allow write: if isAdmin();
      }
      match /settings/usage {
        allow read: if isOwner(uid) || isAdmin();
        // Client may only increment its own usage counters, never decrease/reset them.
        allow create: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.messagesToday >= resource.data.messagesToday
          && request.resource.data.messagesMonth >= resource.data.messagesMonth;
        allow delete: if isAdmin();
      }

      // Chats (each chat is one document containing its messages array)
      match /chats/{chatId} {
        allow read, write, delete: if isOwner(uid);
        allow read: if isModOrAdmin(); // metadata visibility for moderation; see note in README
      }
    }

    // ---- username uniqueness reservations ----
    match /usernames/{username} {
      allow read: if true; // needed for client-side availability checks
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid || isAdmin();
      allow update: if false;
    }

    // ---- audit logs: admin-write, admin-read only ----
    match /auditLogs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---- notifications, reports, system settings ----
    match /notifications/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /reports/{id} {
      allow create: if isSignedIn();
      allow read, update: if isModOrAdmin();
    }
    match /systemSettings/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
